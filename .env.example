# Tryzeon 官網環境變數範例
# 複製此檔案為 .env.local 並填入實際值

# 站台基本資訊
NEXT_PUBLIC_SITE_URL=https://tryzeon.com
NEXT_PUBLIC_SITE_NAME=Tryzeon

# 聯絡資訊
NEXT_PUBLIC_CONTACT_EMAIL=contact@tryzeon.com

# Google Analytics（可選）
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 短連結 /s/{code} 的解析端點（Supabase edge function，回傳決策 JSON）
# SHORT_LINKS_URL=https://<project-ref>.supabase.co/functions/v1/short-links

# /product/{id} 的預覽卡（og:*）資料來源。未設定時退回通用「下載 App」文案。
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon key>
